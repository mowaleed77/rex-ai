# Copy to .env (git-ignored) and fill in. Without a key the bot uses the rule-based fallback.
LLM_API_KEY=
# Any OpenAI-compatible endpoint:
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Groq:   https://api.groq.com/openai/v1   model: llama-3.3-70b-versatile
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/   model: gemini-2.0-flash
# Ollama: http://localhost:11434/v1  (key can be any text)
