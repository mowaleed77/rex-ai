# Copy to .env and fill in what you need. Never commit .env.

# --- LLM (any OpenAI-compatible API) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# --- RFP live discovery ---
TAVILY_API_KEY=

# --- Sign-in: the first admin account (created automatically on first run) ---
# If REX_ADMIN_PASSWORD is empty the demo password Admin@12345 is used and you are forced to change it at first sign-in.
REX_ADMIN_USER=admin
REX_ADMIN_PASSWORD=
REX_ADMIN_EMAIL=

# --- RFP e-mail digest (optional; without SMTP the e-mail is saved as an .eml file in generated_docs/outbox) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
REX_RFP_RECIPIENTS=

# --- Marketing publisher (posts APPROVED campaigns for real) ---
# dry = nothing is sent, you only see what would be posted. live = really post.
REX_PUBLISH_MODE=dry
# Facebook Page + Instagram Business (Meta Graph API). Token = a Page access token with
# pages_manage_posts (+ instagram_content_publish for Instagram). Prefer a long-lived/system-user token.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
GRAPH_API_VERSION=v25.0
# LinkedIn Posts API. Company page: urn:li:organization:<id> + scope w_organization_social.
# Your own profile: urn:li:person:<id> + scope w_member_social. Version = YYYYMM (check LinkedIn's docs).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202607
# E-mail campaigns reuse the SMTP_* settings above. Only list people who agreed to receive them.
REX_MARKETING_RECIPIENTS=

# --- Optional ---
# REX_DB_PATH=data/rex.db
# REX_ARABIC_FONT=C:\Windows\Fonts\arial.ttf
